FROM nginx

ADD ./index.html /var/www/html/index.html
ADD ./nginx-conf/nginx.conf /etc/nginx/conf.d/default.conf

# Проброс готовых сертификатов
ADD ./certificates/certificate.crt /etc/nginx/ssl/
ADD ./certificates/key.key /etc/nginx/ssl/

RUN /usr/sbin/nginx -t

STOPSIGNAL SIGTERM

CMD ["nginx", "-g", "daemon off;"]
